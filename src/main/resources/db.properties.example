# Plantilla de conexión a PostgreSQL.
# Copia este archivo como "db.properties" (en esta misma carpeta) y ajusta
# usuario y clave a los de tu instalación. db.properties NO se sube a git.
# También se pueden sobrescribir con variables de entorno:
#   PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE
db.host=localhost
db.port=5432
db.name=restaurante
db.user=postgres
db.password=postgres
